# Copy to .env (git-ignored). Never commit real keys.
# openrouter or anthropic = real model calls. mock = free, offline, canned data clearly labelled in the UI.
MODEL_PROVIDER=openrouter
# With anthropic use claude-sonnet-5-5. A paid OpenRouter model must be added to PRICES in app/harness.py first.
MODEL_ID=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Aborts a pipeline run once its estimated spend passes this.
MAX_COST_USD=1.00
