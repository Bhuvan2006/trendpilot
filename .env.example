# Copy to .env (git-ignored). Never commit real keys.
# nvidia, anthropic or openrouter = real model calls. mock = free, offline, canned data clearly labelled in the UI.
MODEL_PROVIDER=nvidia
# With anthropic use claude-sonnet-5-5. With openrouter use a :free model, or add a paid one to PRICES in app/harness.py.
MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Aborts a pipeline run once its estimated spend passes this.
MAX_COST_USD=1.00
